{
  "name": "babyapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test",
    "prepare:ocr": "node scripts/prepare-ocr.js",
    "postinstall": "npm run prepare:ocr",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && python3 scripts/android-tool.py ./android/gradlew -p android assembleRelease --max-workers=4 --no-daemon --console=plain && python3 scripts/sign-apk.py",
    "dev:web": "vite --mode web --host 0.0.0.0",
    "build:web": "vite build --mode web --base=./ && node scripts/secure-web-build.js",
    "build:pages": "vite build --mode web --base=./ && node scripts/secure-web-build.js"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "lucide": "^0.468.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "vite": "^6.1.0"
  }
}
